PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/review-manager
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:3000

# OAuth web application credentials; keep these on the server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/business/google/callback
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep stable across deploys, and store securely with your database backups.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Only works when NODE_ENV=development. Never enables demos in production.
GOOGLE_BUSINESS_MOCK=false
# Optional real WhatsApp tests for demo events; also requires the per-review checkbox.
# Ignored outside development. Replies to Google remain simulated.
DEMO_WHATSAPP_ENABLED=false
# New Google reviews are detected on this schedule, not instantly.
REVIEW_POLL_INTERVAL_MINUTES=1

# Optional: needed for AI suggestions / WhatsApp notifications, not initial sync.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Include the whatsapp: prefix and international country code.
TWILIO_WHATSAPP_NUMBER=
# Approved Content Template SID (HX...). Required for production alerts.
TWILIO_REVIEW_ALERT_CONTENT_SID=

# Existing billing configuration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY_ID=
RAZORPAY_PLAN_QUARTERLY_ID=
RAZORPAY_PLAN_SEMI_ANNUAL_ID=

# Use one always-on backend instance with this enabled; disable in web replicas if a separate worker runs it.
RUN_REVIEW_POLLER=true
# Render/Railway reverse proxy. Use 0 for direct local connections.
TRUST_PROXY_HOPS=0
# Enable only after configuring and testing Razorpay signatures and webhook delivery.
BILLING_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=
